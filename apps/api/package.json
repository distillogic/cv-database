{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "Melas Recruitment CRM REST API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migrations-table pgmigrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:redo": "npm run migrate -- redo",
    "migrate:create": "npm run migrate -- create --migration-file-language ts --migration-filename-format utc"
  },
  "keywords": [
    "crm",
    "recruitment",
    "resumes"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "node-pg-migrate": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
